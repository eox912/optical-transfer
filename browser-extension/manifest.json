{
  "manifest_version": 3,
  "name": "光学隔空传输",
  "version": "0.1.0",
  "description": "把文件编码成连续播放的动态二维码在屏幕播放，用摄像头在另一端扫描还原。单向光学信道，不依赖网络、蓝牙、数据线。",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "光学隔空传输（点击打开）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
